---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SunsetTable from '../components/SunsetTable.astro';
import ServerIslandFallback from '../components/ServerIslandFallback.astro';
import { breadcrumb } from '../lib/schema';

const crumbs = [
  { name: '首頁', href: '/' },
  { name: '日落時間', href: '/sunset/' },
];
---

<BaseLayout
  title="南寮日落時間｜魚鱗天梯夕陽拍照最佳時段"
  description="南寮魚鱗天梯日落時間表，提供未來兩週的日出、日落與黃金拍照窗口，幫你安排最美的夕陽時段。"
  jsonLd={[breadcrumb(crumbs)]}
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-4 text-3xl font-bold">南寮魚鱗天梯日落時間</h1>
    <p class="mt-3 text-ink/75">
      最佳觀賞窗口約在日落前 60 至 90 分鐘到日落後 20 分鐘之間，天空色溫最好看。以下為新竹海岸位置依當地日期即時計算的天文資料，並自動標示今天。
    </p>

    <div class="mt-6">
      <SunsetTable server:defer>
        <ServerIslandFallback slot="fallback" label="正在計算日落時間" rows={4} />
      </SunsetTable>
    </div>
    <p class="mt-3 text-xs text-ink/55">
      日出日落為天文計算（Asia/Taipei），實際受地形與天氣影響。夕陽可見度請對照<a href="/weather/" class="underline">天氣與海象</a>。
    </p>
  </div>
</BaseLayout>
