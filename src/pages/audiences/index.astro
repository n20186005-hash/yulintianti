---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SourceBlock from '../../components/SourceBlock.astro';
import { breadcrumb, faqPage } from '../../lib/schema';

const crumbs = [
  { name: '首頁', href: '/' },
  { name: '人群定制方案', href: '/audiences/' },
];

const faqs = [
  {
    q: '帶小孩去魚鱗天梯要注意什麼？',
    a: '下層階梯與消波塊對幼童風險較高，建議以港區上層步道、草坪與沙灘為主要活動範圍，並全程牽緊孩童。出發前先確認洗手間位置、攜帶替換衣物與防曬用品，時間控制在 1.5 至 2.5 小時內最舒適。',
  },
  {
    q: '想拍出好看的夕陽照片，建議什麼時間到？',
    a: '建議在日落前 60 至 90 分鐘抵達，先確認當日潮汐與雲量。日落前的斜射光與日落後的藍調時段各有特色；若想拍到水面質感，可搭配滿潮前後時段。',
  },
  {
    q: '長輩或行動不便者可以參觀嗎？',
    a: '可以。港區與上層步道多為平坦路面，輪椅與嬰兒車可通行至觀景位置遠觀海景；魚鱗天梯本身為階梯結構，不適合輪椅與推車。建議安排 1 小時左右、避開強風與高溫時段。',
  },
  {
    q: '半日與全日行程差在哪裡？',
    a: '半日以魚鱗天梯與港區為核心，約 3 至 4 小時；全日則會延伸串連十七公里海岸線、香山濕地或市區景點，約 6 至 8 小時，適合自駕或騎乘自行車的旅客。',
  },
];

const audiences = [
  {
    id: 'family',
    emoji: '👨‍👩‍👧',
    title: '親子家庭',
    subtitle: '以安全與節奏為優先',
    best: '上午 9–11 時或日落前 1.5 小時',
    duration: '1.5–2.5 小時',
    route: [
      '港區停車場 → 公共洗手間、補充飲水',
      '上層步道遠觀魚鱗天梯與海景（牽緊孩童）',
      '草坪或沙灘自由活動、放風箏',
      '市集或便利商店簡單用餐後返程',
    ],
    tips: [
      '幼童避免進入下層階梯與消波塊區域',
      '必備：防曬帽、防蚊液、替換衣物、飲水',
      '夏季避開 10–14 時，避免中暑與沙地燙傷',
    ],
    link: { label: '親子半日遊行程', href: '/itineraries/family/' },
  },
  {
    id: 'photo',
    emoji: '📷',
    title: '攝影與自然愛好者',
    subtitle: '跟著光線與潮汐走',
    best: '日落前 90 分鐘至日落後 30 分鐘',
    duration: '2–4 小時（可延長）',
    route: [
      '先確認潮汐與雲量，選定拍攝位置',
      '日落前拍攝階梯幾何與水面倒影',
      '日落後藍調時段補拍長曝與車軌',
      '有興致可延伸至香山濕地拍候鳥',
    ],
    tips: [
      '斜射光最能表現階梯的層次與紋理',
      '海邊風大，腳架請壓重並保護鏡頭',
      '潮濕環境請備拭鏡布與防潮措施',
    ],
    link: { label: '拍照位置建議', href: '/photo-spots/' },
  },
  {
    id: 'accessible',
    emoji: '♿',
    title: '低體力與無障礙',
    subtitle: '短程、平坦、有休憩點',
    best: '避開強風與高溫，上午或傍晚',
    duration: '40–60 分鐘',
    route: [
      '選擇距離步道入口最近的停車場',
      '港區平面與上層步道觀景、拍照',
      '尋找遮蔭或座椅休息、補充水分',
      '可視體力延伸至市集室內空間',
    ],
    tips: [
      '魚鱗天梯下層為階梯，輪椅與推車不適合',
      '港區部分洗手間設有無障礙設施',
      '冬季風強體感低，請備防風保暖衣物',
    ],
    link: { label: '訪客服務與設施', href: '/facilities/' },
  },
  {
    id: 'couple',
    emoji: '💑',
    title: '情侶與好友',
    subtitle: '夕陽與夜拍的組合',
    best: '日落前 1 小時至入夜',
    duration: '2–3 小時',
    route: [
      '傍晚抵達，先散步看海與漁港',
      '日落時分拍照、看天色變化',
      '市集或周邊簡單用餐',
      '入夜後於安全處短暫停留，避免下層海岸',
    ],
    tips: [
      '夜間照明不足，請自行攜帶照明並遠離浪區',
      '假日傍晚人潮多，建議提早抵達卡位',
      '海邊風大，外套與髮型用品很實用',
    ],
    link: { label: '兩小時夕陽版行程', href: '/itineraries/two-hours/' },
  },
];

const halfDay = [
  { time: '第 1 小時', plan: '抵達港區停車、上洗手間、了解環境與天氣' },
  { time: '第 2 小時', plan: '上層步道與魚鱗天梯觀景、拍照' },
  { time: '第 3 小時', plan: '草坪、沙灘活動或市集參觀' },
  { time: '第 4 小時', plan: '簡單用餐、補水，彈性返程' },
];

const fullDay = [
  { time: '上午', plan: '南寮漁港、波光市集與魚鱗天梯，先熟悉環境並拍攝日景' },
  { time: '中午', plan: '港區用餐與休息，避開正午最強日照' },
  { time: '下午', plan: '騎乘十七公里海岸線，串連港南運河、香山濕地等節點' },
  { time: '傍晚', plan: '返回南寮一帶看日落，或於沿線另覓觀景點' },
  { time: '入夜', plan: '市區用餐後返程，避免夜間進入海岸下層' },
];
---

<BaseLayout
  title="南寮魚鱗天梯人群定制方案與通用路線｜親子、攝影、無障礙與半日全日行程"
  description="依出行族群安排的南寮魚鱗天梯遊覽方案：親子家庭、攝影與自然愛好者、低體力與無障礙、情侶好友，並附半日與全日通用行程時間表與實用提醒。"
  jsonLd={[breadcrumb(crumbs), faqPage(faqs)]}
>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-4 text-3xl font-bold">人群定制方案與通用路線</h1>
    <p class="mt-3 leading-relaxed text-ink/80">
      同一個地方，帶小孩、拍夕陽、陪長輩散步，最適合的時段與動線完全不同。這一頁依<strong>出行組成與體力條件</strong>分成四種方案，並附上通用版的半日與全日行程，方便你直接對照安排。
    </p>

    <section class="mt-10">
      <h2 class="text-2xl">四種族群方案</h2>
      <div class="mt-5 space-y-5">
        {
          audiences.map((a) => (
            <article class="rounded-2xl border border-scale bg-white p-5 sm:p-6">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h3 class="flex items-center gap-2 text-lg font-semibold text-deepsea">
                    <span aria-hidden="true">{a.emoji}</span>
                    {a.title}
                  </h3>
                  <p class="mt-0.5 text-sm text-ink/65">{a.subtitle}</p>
                </div>
                <div class="flex flex-wrap gap-2 text-xs">
                  <span class="rounded-full bg-scale px-3 py-1 text-ink/75">建議時段：{a.best}</span>
                  <span class="rounded-full bg-scale px-3 py-1 text-ink/75">停留：{a.duration}</span>
                </div>
              </div>

              <div class="mt-4 grid gap-5 sm:grid-cols-2">
                <div>
                  <h4 class="text-sm font-semibold text-deepsea">建議動線</h4>
                  <ol class="mt-2 space-y-1.5 text-sm text-ink/80">
                    {a.route.map((step, i) => (
                      <li class="flex gap-2">
                        <span class="shrink-0 font-semibold text-coast">{i + 1}.</span>
                        <span>{step}</span>
                      </li>
                    ))}
                  </ol>
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-deepsea">注意事項</h4>
                  <ul class="mt-2 space-y-1.5 text-sm text-ink/80">
                    {a.tips.map((t) => (
                      <li class="flex gap-2">
                        <span class="shrink-0 text-sunset" aria-hidden="true">•</span>
                        <span>{t}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <a href={a.link.href} class="mt-4 inline-block text-sm font-semibold text-deepsea underline hover:text-sunset">
                {a.link.label} →
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl">通用遊覽路線</h2>
      <p class="mt-2 text-sm text-ink/70">以下為不特別區分族群的通用版本，可依實際天氣、潮汐與體力彈性調整。</p>

      <div class="mt-5 grid gap-5 lg:grid-cols-2">
        <div class="rounded-2xl border border-scale bg-white p-5">
          <h3 class="text-lg font-semibold text-deepsea">半日行程（約 3–4 小時）</h3>
          <p class="mt-1 text-sm text-ink/65">以魚鱗天梯與港區為核心，適合初次到訪或行程較緊的旅客。</p>
          <table class="mt-4 w-full border-collapse text-sm">
            <tbody>
              {
                halfDay.map((r, i) => (
                  <tr class:list={[i % 2 ? 'bg-scale/50' : 'bg-white']}>
                    <th class="w-24 whitespace-nowrap px-3 py-2.5 text-left font-semibold text-deepsea">
                      {r.time}
                    </th>
                    <td class="px-3 py-2.5 text-ink/80">{r.plan}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <a href="/itineraries/half-day/" class="mt-3 inline-block text-sm font-semibold text-deepsea underline hover:text-sunset">
            半日遊完整版本 →
          </a>
        </div>

        <div class="rounded-2xl border border-scale bg-white p-5">
          <h3 class="text-lg font-semibold text-deepsea">全日行程（約 6–8 小時）</h3>
          <p class="mt-1 text-sm text-ink/65">串連十七公里海岸線，適合自駕或騎乘自行車的旅客。</p>
          <table class="mt-4 w-full border-collapse text-sm">
            <tbody>
              {
                fullDay.map((r, i) => (
                  <tr class:list={[i % 2 ? 'bg-scale/50' : 'bg-white']}>
                    <th class="w-20 whitespace-nowrap px-3 py-2.5 text-left font-semibold text-deepsea">
                      {r.time}
                    </th>
                    <td class="px-3 py-2.5 text-ink/80">{r.plan}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <a href="/itineraries/one-day/" class="mt-3 inline-block text-sm font-semibold text-deepsea underline hover:text-sunset">
            全日行程完整版本 →
          </a>
        </div>
      </div>

      <p class="mt-4 rounded-xl border border-scale bg-scale/40 p-4 text-sm leading-relaxed text-ink/75">
        行程天數與節奏可再依天氣調整：風勢過強或浪高偏高時，請改以下層以外的區域為主，或改走
        <a href="/itineraries/rainy-day/" class="underline">雨天備案</a>。出發前請先看
        <a href="/today/" class="underline">今日狀況</a>與<a href="/weather/" class="underline">天氣與海象</a>。
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl">常見問題</h2>
      <div class="mt-4 space-y-5">
        {
          faqs.map((f) => (
            <div>
              <h3 class="text-base font-semibold text-deepsea">{f.q}</h3>
              <p class="mt-1.5 leading-relaxed text-ink/80">{f.a}</p>
            </div>
          ))
        }
      </div>
    </section>

    <SourceBlock
      sources={[
        { label: '新竹市政府觀光旅遊網', href: 'https://tourism.hccg.gov.tw/' },
        { label: '交通部觀光署', href: 'https://www.taiwan.net.tw/' },
        { label: '中央氣象署（天氣與海象）', href: 'https://www.cwa.gov.tw/' },
        { label: '交通部中央氣象署潮汐資料', href: 'https://www.cwa.gov.tw/V8/C/T/Marine.html' },
      ]}
    />
  </div>
</BaseLayout>
