---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TodayStatus from '../components/TodayStatus.astro';
import LiveWeather from '../components/LiveWeather.astro';
import LiveTide from '../components/LiveTide.astro';
import ServerIslandFallback from '../components/ServerIslandFallback.astro';
import QuickFacts from '../components/QuickFacts.astro';
import PlaceMap from '../components/PlaceMap.astro';
import Card from '../components/Card.astro';
import GoogleRating from '../components/GoogleRating.astro';
import SourceBlock from '../components/SourceBlock.astro';
import { SITE } from '../data/site.js';
import places from '../data/places.json';
import {
  website,
  organization,
  touristAttraction,
  faqPage,
} from '../lib/schema';

const facts = [
  { label: '地址', value: `${SITE.address.city}${SITE.address.district}${SITE.address.street}` },
  { label: 'Plus Code', value: SITE.plusCode },
  { label: 'Google 評分', value: `${SITE.googleRating.value}（${SITE.googleRating.count.toLocaleString('en-US')} 則評價）` },
  { label: '門票', value: '免費' },
  { label: '建議停留', value: '30 至 60 分鐘' },
  { label: '最佳時間', value: '日落前 60 至 90 分鐘' },
  { label: '適合族群', value: '情侶、親子、攝影、單車' },
  { label: '無障礙', value: '上層步道可觀景，下層階梯不便' },
  { label: '寵物', value: '戶外空間，請繫牽繩' },
  { label: '夜間', value: '不建議進入靠海下層' },
];

// SEO：位置與交通語義（Location & How to Visit）
const howToVisit = [
  { label: '開車導航', value: `Google 地圖搜尋「${SITE.fullName}」或 Plus Code ${SITE.plusCode}` },
  { label: '大眾運輸', value: '新竹火車站前搭乘往南寮方向公車，於南寮站下車步行前往' },
  { label: '單車', value: '位於 17 公里海岸線起點附近，可自南寮租車站騎乘串連' },
  { label: '停車', value: '南寮漁港第一停車場步行約 8 分鐘，假日午後建議改停第二停車場' },
];

// SEO：周邊語義集群（Landmarks & Attractions Around）
const nearby = [
  { name: '南寮漁港（新竹漁港）', href: '/nanliao-harbor/', note: '17 公里海岸線起點、漁市與遊艇碼頭' },
  { name: '波光市集', href: '/boguang-market/', note: '白色波浪建築的餐飲與伴手禮聚落' },
  { name: '親子沙灘', href: '/family-beach/', note: '可玩沙的緩坡沙灘與大草坪' },
  { name: '國際風箏賽場', href: '/kite-field/', note: '海風穩定的放風箏大草坪' },
  { name: '17 公里海岸線', href: '/17km-coastline/', note: '串連港南運河與香山濕地的自行車道' },
];

const routes = [
  {
    href: '/itineraries/two-hours/',
    image: '/images/harbor-scenery.jpg',
    alt: '魚鱗天梯夕陽',
    title: '兩小時夕陽版',
    desc: '波光市集 → 國際風箏賽場 → 魚鱗天梯 → 看夕陽',
    tag: '約 2 小時',
  },
  {
    href: '/itineraries/family/',
    image: '/images/seashell-park.jpg',
    alt: '親子沙灘',
    title: '親子半日版',
    desc: '旅客服務中心 → 親子沙灘 → 放風箏 → 魚鱗天梯 → 晚餐',
    tag: '約半日',
  },
  {
    href: '/itineraries/one-day/',
    image: '/images/coast-bridge.jpg',
    alt: '17 公里海岸線',
    title: '單車一日版',
    desc: '南寮租車 → 魚鱗天梯 → 港南運河 → 香山濕地 → 返回南寮',
    tag: '約一日',
  },
];

// 深度專題：從「怎麼去」延伸到「為什麼是這樣」
const deepDives = [
  {
    href: '/history/',
    emoji: '📜',
    title: '歷史與在地故事',
    desc: '從出海口旁的漁村聚落、新竹漁港的闢建與轉型，到魚鱗天梯護岸的形成，以及風城九降風如何形塑這裡的生活。',
  },
  {
    href: '/seasons/',
    emoji: '🍂',
    title: '四季遊覽策略與生態',
    desc: '春、夏、秋、冬的氣溫、風勢、海象與水質差異，以及 12 個月的生態觀察日曆與候鳥季節。',
  },
  {
    href: '/facilities/',
    emoji: '🚻',
    title: '訪客服務與周邊設施',
    desc: '洗手間、停車、餐飲類型、住宿安排、便利商店與超市、加油與充電、提款藥局、無障礙與寵物規範。',
  },
  {
    href: '/audiences/',
    emoji: '👨‍👩‍👧',
    title: '人群定制方案',
    desc: '親子家庭、攝影與自然愛好者、低體力與無障礙、情侶好友四種動線，加上半日與全日通用行程時間表。',
  },
  {
    href: '/responsibility/',
    emoji: '🧭',
    title: '科普與訪客責任',
    desc: '消波塊與護岸為什麼這樣設計、瘋狗浪與離岸流怎麼判斷、落水自救順序，以及保育與垃圾帶走守則。',
  },
  {
    href: '/tide/',
    emoji: '🌊',
    title: '即時潮汐看板',
    desc: '目前潮位與漲退潮趨勢、下一次滿潮與乾潮倒數、24 小時潮位曲線、一週潮汐表與潮汐小辭典。',
  },
];

const faqs = [
  { q: '魚鱗天梯在哪裡？', a: '位於新竹市北區新港路（南寮漁港），Plus Code 為 VW2F+WF；在 Google 地圖搜尋「南寮魚鱗天梯」即可導航。' },
  { q: '魚鱗天梯要門票嗎？', a: '免費，是全天開放的戶外海岸空間，不需預約。' },
  { q: '魚鱗天梯幾點去最好？', a: '建議日落前 60 至 90 分鐘抵達，兼顧散步、拍照與看夕陽。' },
  { q: '魚鱗天梯開放時間？', a: '戶外空間全天開放；夜間光線不足，不建議進入靠海下層階梯。' },
  { q: '退潮時還值得去嗎？', a: '值得，但海景會離階梯較遠，可改看消波結構或安排到波光市集用餐。' },
  { q: '魚鱗天梯附近還有什麼景點？', a: '步行可到南寮漁港與波光市集，再遠一點有親子沙灘、國際風箏賽場與 17 公里海岸線自行車道。' },
  { q: '車停哪裡最方便？', a: '南寮漁港第一停車場最近，步行到階梯約 8 分鐘；假日午後容易滿，可改停第二停車場。' },
];

const jsonLd = [
  website(),
  organization(),
  touristAttraction({
    name: '南寮魚鱗天梯',
    description:
      '南寮魚鱗天梯是新竹漁港海岸的消波護岸階梯，遠看如魚鱗，是熱門的看海與夕陽拍照地點。',
    image: '/images/harbor-scenery.jpg',
    lat: SITE.geo.lat,
    lng: SITE.geo.lng,
    address: '新竹市北區新港路',
    url: '/',
    alternateName: SITE.alternateNames,
    // 評分屬「南寮魚鱗天梯」這個實體，且頁面上已明確標註來自 Google 地圖
    aggregateRating: SITE.googleRating.includeInJsonLd
      ? { value: SITE.googleRating.value, count: SITE.googleRating.count }
      : undefined,
  }),
  faqPage(faqs),
];
---

<BaseLayout
  title="南寮魚鱗天梯旅遊指南｜天氣潮汐、波光市集與交通停車攻略"
  description="新竹南寮漁港旅遊指南：魚鱗天梯最佳拍照時間、波光市集美食、17 公里海岸線單車路線，以及出發前必看的即時天氣、風速與潮汐預報。"
  appendBrand={false}
  jsonLd={jsonLd}
>
  <Hero
    image="/images/harbor-scenery.jpg"
    alt="新竹南寮魚鱗天梯海岸與夕陽"
    h1="南寮魚鱗天梯：今天適合去嗎？"
    subtitle="出發前先查看南寮風速、降雨、漲退潮和日落時間，再安排魚鱗天梯、南寮漁港與 17 公里海岸線行程。"
    eager={true}
    buttons={[
      { label: '查看今日狀況', href: '/today/', primary: true },
      { label: '查看潮汐', href: '/tide/' },
      { label: '停車與導航', href: '/parking/' },
      { label: '安排半日遊', href: '/itineraries/half-day/' },
      { label: 'Google 地圖', href: SITE.mapsUrl, external: true },
    ]}
  />

  <div class="mx-auto max-w-6xl px-4">
    <!-- 今日狀況（全站最重要模組；於邊緣節點即時計算） -->
    <section class="-mt-10 relative z-10">
      <TodayStatus server:defer>
        <ServerIslandFallback slot="fallback" label="正在確認今日狀況" />
      </TodayStatus>
    </section>

    <!-- 即時天氣模組（伺服器端渲染 + 邊緣快取） -->
    <section class="mt-6">
      <LiveWeather context="home" server:defer>
        <ServerIslandFallback slot="fallback" label="正在載入即時天氣" />
      </LiveWeather>
    </section>

    <!-- 即時潮汐模組（伺服器端渲染 + 邊緣快取） -->
    <section class="mt-6">
      <LiveTide context="home" server:defer>
        <ServerIslandFallback slot="fallback" label="正在載入即時潮汐" rows={4} />
      </LiveTide>
    </section>

    <!-- Google 地圖評價（最新評分，並標註來源） -->
    <section class="mt-6">
      <GoogleRating />
    </section>

    <!-- 快速資訊卡 -->
    <section class="mt-12 grid gap-8 lg:grid-cols-2">
      <QuickFacts rows={facts} title="魚鱗天梯快速資訊" />
      <div class="rounded-2xl border border-scale bg-white p-6">
        <h2 class="text-lg">為什麼看南寮魚鱗天梯？</h2>
        <p class="mt-3 text-ink/80">
          我們不只介紹「魚鱗天梯是什麼」，更幫你回答出發前真正在意的問題：
        </p>
        <ul class="mt-3 space-y-2 text-ink/80">
          <li>· 今天適合去嗎？現在風會不會太大？</li>
          <li>· 今天幾點看夕陽？幾點漲潮、退潮？</li>
          <li>· 車停哪裡最方便？帶小孩可以怎麼玩？</li>
          <li>· 玩兩小時還是安排半日遊？附近還有什麼？</li>
        </ul>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href="/weather/" class="rounded-full border border-deepsea px-4 py-2 text-sm font-semibold text-deepsea hover:bg-scale">天氣與海象</a>
          <a href="/transport/" class="rounded-full border border-deepsea px-4 py-2 text-sm font-semibold text-deepsea hover:bg-scale">交通方式</a>
          <a href="/photo-spots/" class="rounded-full border border-deepsea px-4 py-2 text-sm font-semibold text-deepsea hover:bg-scale">拍照位置</a>
        </div>
      </div>
    </section>

    <!-- 認識南寮魚鱗天梯（SEO 實體語義：全稱＝簡稱、地理歸屬、周邊語義集群、權威外鏈） -->
    <section class="mt-14" aria-labelledby="about-heading">
      <div class="rounded-2xl border border-scale bg-white p-6 sm:p-8">
        <h2 id="about-heading" class="text-2xl">關於南寮魚鱗天梯（新竹市北區）</h2>
        <p class="mt-4 leading-relaxed text-ink/80">
          <strong>南寮魚鱗天梯（Nanliao Stairway）</strong>位於<strong>新竹市</strong>北區新港路、南寮漁港海岸，是南寮一帶最受歡迎的海岸地標，一般習慣直接稱呼<strong>魚鱗天梯</strong>。它以消波塊層層堆疊成階梯狀護岸，兼具消波、護岸與觀景功能，也是新竹 17 公里海岸線起點附近最重要的看海、追夕陽與拍照景點。
        </p>
        <p class="mt-3 text-sm text-ink/65">
          地理歸屬：南寮魚鱗天梯 → 新竹市北區 → 新竹市 → 臺灣（Taiwan，郵遞區號 300）
        </p>
        <p class="mt-3 leading-relaxed text-ink/80">
          造訪<strong>南寮魚鱗天梯</strong>時，可順遊周邊核心地標<strong>南寮漁港（新竹漁港）</strong>與<strong>波光市集</strong>，再往北銜接親子沙灘、國際風箏賽場與 17 公里海岸線自行車道。
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href={SITE.mapsUrl} target="_blank" rel="noopener" class="rounded-full bg-deepsea px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-ink">在 Google 地圖開啟</a>
          <a href="/transport/" class="rounded-full border border-deepsea px-4 py-2 text-sm font-semibold text-deepsea hover:bg-scale">交通方式</a>
          <a href={SITE.govtTourismUrl} target="_blank" rel="noopener" class="rounded-full border border-deepsea px-4 py-2 text-sm font-semibold text-deepsea hover:bg-scale">{SITE.govtTourismLabel} ↗</a>
        </div>
      </div>
    </section>

    <!-- SEO：位置與交通（Location & How to Visit） -->
    <section class="mt-14" aria-labelledby="visit-heading">
      <h2 id="visit-heading" class="text-2xl">位置與交通：如何前往南寮魚鱗天梯</h2>
      <p class="mt-3 leading-relaxed text-ink/80">
        <strong>南寮魚鱗天梯（Nanliao Stairway）</strong>位於<strong>臺灣新竹市北區新港路</strong>（郵遞區號 300，Plus Code <strong>{SITE.plusCode}</strong>），緊鄰南寮漁港海岸，開車、公車與單車都能抵達。
      </p>
      <dl class="mt-5 grid gap-3 sm:grid-cols-2">
        {
          howToVisit.map((x) => (
            <div class="rounded-xl border border-scale bg-white p-4">
              <dt class="text-sm font-semibold text-deepsea">{x.label}</dt>
              <dd class="mt-1 text-sm text-ink/75">{x.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="mt-5 flex flex-wrap gap-2">
        <a href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-deepsea px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-ink">在 Google 地圖開啟南寮魚鱗天梯 ↗</a>
        <a href="/transport/" class="rounded-full border border-deepsea px-4 py-2 text-sm font-semibold text-deepsea hover:bg-scale">完整交通方式</a>
        <a href="/parking/" class="rounded-full border border-deepsea px-4 py-2 text-sm font-semibold text-deepsea hover:bg-scale">停車攻略</a>
      </div>
    </section>

    <!-- SEO：歷史與意義（History & Significance） -->
    <section class="mt-14" aria-labelledby="history-heading">
      <div class="rounded-2xl border border-scale bg-white p-6 sm:p-8">
        <h2 id="history-heading" class="text-2xl">歷史與意義：南寮魚鱗天梯的由來</h2>
        <p class="mt-4 leading-relaxed text-ink/80">
          南寮魚鱗天梯是新竹漁港（南寮漁港）海岸改造工程的一部分，以消波塊層層堆疊成階梯狀護岸，兼具<strong>消波</strong>、<strong>護岸</strong>與<strong>休憩觀景</strong>功能。因為階梯層疊、遠看像魚鱗而得名，如今已成為南寮海岸線最具辨識度的地標，也是 17 公里海岸線起點附近重要的看海、追夕陽與婚紗拍攝地點。
        </p>
        <p class="mt-3 text-sm text-ink/65">
          工程性質與定位依據新竹市政府香山濕地生態網、新竹市政府觀光旅遊網等公開資料整理；實際構造與開放範圍請以現場公告為準。
        </p>
      </div>
    </section>

    <!-- SEO：周邊地標語義集群（Landmarks & Attractions Around） -->
    <section class="mt-14" aria-labelledby="landmarks-heading">
      <h2 id="landmarks-heading" class="text-2xl">南寮魚鱗天梯周邊地標</h2>
      <p class="mt-3 leading-relaxed text-ink/80">
        造訪<strong>南寮魚鱗天梯</strong>時，可順遊下列周邊核心地標與景點：
      </p>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          nearby.map((n) => (
            <li class="rounded-xl border border-scale bg-white p-4">
              <a href={n.href} class="font-semibold text-deepsea underline hover:text-sunset">{n.name}</a>
              <p class="mt-1 text-sm text-ink/70">{n.note}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 互動地圖 -->
    <section class="mt-14">
      <div class="flex items-end justify-between gap-3">
        <h2 class="text-2xl">南寮漁港景點地圖</h2>
        <a href="/map/" class="text-sm font-semibold text-deepsea underline">看完整地圖</a>
      </div>
      <div class="mt-5">
        <PlaceMap height="360px" />
      </div>
    </section>

    <!-- 三種推薦路線 -->
    <section class="mt-14">
      <div class="flex items-end justify-between gap-3">
        <h2 class="text-2xl">三種推薦路線</h2>
        <a href="/itineraries/" class="text-sm font-semibold text-deepsea underline">看更多行程</a>
      </div>
      <div class="mt-5 grid gap-6 md:grid-cols-3">
        {routes.map((r) => <Card {...r} />)}
      </div>
    </section>

    <!-- 南寮景點 -->
    <section class="mt-14">
      <div class="flex items-end justify-between gap-3">
        <h2 class="text-2xl">南寮景點</h2>
        <a href="/nanliao-harbor/" class="text-sm font-semibold text-deepsea underline">南寮漁港總覽</a>
      </div>
      <p class="mt-2 text-sm text-ink/70">
        魚鱗天梯周邊順遊：南寮漁港、波光市集、親子沙灘、國際風箏賽場與 17 公里海岸線。
      </p>
      <div class="mt-5 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          places.map((p) => (
            <Card
              href={`/${p.slug}/`}
              image={p.image}
              alt={`${p.name}｜鄰近${SITE.shortName}的南寮順遊景點`}
              title={p.name}
              desc={p.summary}
            />
          ))
        }
      </div>
    </section>

    <!-- 深度專題（專業科普內容入口） -->
    <section class="mt-14" aria-labelledby="deepdive-heading">
      <div class="flex items-end justify-between gap-3">
        <h2 id="deepdive-heading" class="text-2xl">深度認識南寮海岸</h2>
        <a href="/seasons/" class="text-sm font-semibold text-deepsea underline">從四季與生態開始</a>
      </div>
      <p class="mt-2 text-sm text-ink/70">
        除了怎麼去、幾點去，這裡也解釋「為什麼是這樣」：海洋工程、潮汐成因、季節與生態變化，以及在地的歷史脈絡。
      </p>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          deepDives.map((d) => (
            <a
              href={d.href}
              class="group rounded-2xl border border-scale bg-white p-5 transition-colors hover:border-coast"
            >
              <div class="text-xl" aria-hidden="true">{d.emoji}</div>
              <h3 class="mt-2 text-base font-semibold text-deepsea group-hover:text-sunset">{d.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink/75">{d.desc}</p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- 常見問題 -->
    <section class="mt-14 mb-4">
      <h2 class="text-2xl">常見問題</h2>
      <div class="mt-5 space-y-3">
        {
          faqs.map((f) => (
            <details class="group rounded-xl border border-scale bg-white p-4">
              <summary class="cursor-pointer list-none font-semibold text-deepsea marker:hidden">
                <span class="inline-flex w-full items-center justify-between">
                  {f.q}
                  <span class="ml-2 text-sunset transition-transform group-open:rotate-45">＋</span>
                </span>
              </summary>
              <p class="mt-2 text-ink/80">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

