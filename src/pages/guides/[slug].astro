---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { article, breadcrumb } from '../../lib/schema';
import { placeForGuide } from '../../data/guide-places';

export async function getStaticPaths() {
  const entries = await getCollection('guides');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const url = `/guides/${entry.id}/`;
const place = placeForGuide(entry.id);

const crumbs = [
  { name: '首頁', href: '/' },
  { name: '旅遊攻略', href: '/guides/' },
  { name: d.name, href: url },
];

const jsonLd = [
  breadcrumb(crumbs),
  article({
    headline: d.name,
    description: d.description,
    image: d.heroImage,
    url,
    author: d.editor,
  }),
];
---

<ArticleLayout
  title={d.title}
  description={d.description}
  h1={d.h1}
  oneLiner={d.oneLiner}
  heroImage={d.heroImage}
  heroAlt={d.heroAlt}
  editor={d.editor}
  lastVerifiedAt={d.lastVerifiedAt}
  breadcrumbs={crumbs}
  jsonLd={jsonLd}
>
  <div slot="before" class="mb-8 rounded-2xl border border-scale bg-scale/40 p-5">
    <h2 class="text-xl font-bold text-deepsea">關於這段海岸與所在地</h2>
    <p class="mt-3 text-ink/85">{place.history}</p>
    <p class="mt-2 text-sm text-ink/70">本篇主要地點：{place.name}｜{place.address}</p>
    <a class="mt-4 inline-flex rounded-full bg-deepsea px-5 py-2.5 text-sm font-semibold text-white" href={place.maps} target="_blank" rel="noopener noreferrer">查看 {place.name} 的 Google 地圖與導航</a>
  </div>
  <Content />
  <section class="mt-10 rounded-2xl bg-scale/40 p-5">
    <h2 class="text-2xl font-bold text-deepsea">地景特色與觀察重點</h2>
    <p class="mt-3">{place.design}</p>
    <h3 class="mt-5 text-lg font-semibold text-deepsea">建議步行與交通動線</h3>
    <p class="mt-2">{place.route} 開車可參考<a class="underline" href="/parking/">港區停車資訊</a>；搭公車則先查<a class="underline" href="/transport/">當日班次及回程</a>。個別路段的開放與施工情況以現場標示為準。</p>
    <h3 class="mt-5 text-lg font-semibold text-deepsea">推薦拍攝視角</h3>
    <p class="mt-2">{place.photoTip} 若想在日落時拍照，請事先查看<a class="underline" href="/sunset/">當日日落時間</a>及<a class="underline" href="/weather/">風雨預報</a>。</p>
  </section>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-deepsea">現場實景照片</h2>
    <p class="mt-2 text-sm text-ink/70">以下為站內既有的南寮與新竹海岸實景素材；依本文對應地點選用，非即時現場畫面。</p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {place.photos.map((photo, i) => <figure class="overflow-hidden rounded-xl border border-scale bg-white">
        <img src={photo} alt={`${place.name}及周邊環境實景 ${i + 1}`} loading="lazy" width="900" height="600" class="aspect-[4/3] w-full object-cover" />
        <figcaption class="p-3 text-sm text-ink/70">{place.name}｜周邊風景與遊覽環境 {i + 1}</figcaption>
      </figure>)}
    </div>
  </section>
  <section class="mt-10 rounded-2xl border border-scale p-5">
    <h2 class="text-xl font-bold text-deepsea">行前常見問題</h2>
    <h3 class="mt-4 font-semibold">怎麼找到本文提到的地點？</h3>
    <p class="mt-2">請使用<a href={place.maps} target="_blank" rel="noopener noreferrer" class="underline">{place.name} 專屬 Google 地圖搜尋／地點連結</a>，並依當日道路和現場指引前往。</p>
    <h3 class="mt-4 font-semibold">需要預留多少時間？</h3>
    <p class="mt-2">單一港邊停留通常可先抓約 30 至 60 分鐘；若還要用餐、騎車或跨區到濕地，應另加上移動與休息時間。</p>
  </section>
</ArticleLayout>
