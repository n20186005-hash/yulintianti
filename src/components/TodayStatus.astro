---
/**
 * 今日狀況（伺服器端渲染）
 * 由伺服器島嶼於邊緣節點即時計算：綜合現地天氣、風速、降雨機率、夕陽可見度與潮汐條件。
 * 任一資料源失效時僅降級顯示可用項目，不會把舊資料標示為即時。
 */
import { SITE } from '../data/site.js';
import { getSunset, getGoldenWindow } from '../lib/sunset';
import { evaluateStatus, STATUS_STYLE, type Conditions } from '../lib/status-score';
import {
  getWeather,
  rainProbNow,
  isWeekendInTaipei,
  type WeatherBundle,
} from '../lib/weather-server';
import { getTide, minutesUntil, formatCountdown } from '../lib/tide-server';
import { hasWeatherWarning } from '../lib/weather-advice';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const now = new Date();
const sunset = getSunset(now, SITE.geo.lat, SITE.geo.lng);
const golden = getGoldenWindow(now, SITE.geo.lat, SITE.geo.lng);

// 氣象與潮汐皆於邊緣節點即時取得；取得失敗時只顯示可計算項目，不以舊資料充數
const [wx, marine] = await Promise.all([getWeather(), getTide(now)]);

const nextHigh = marine?.nextHigh ?? null;
const nextLow = marine?.nextLow ?? null;
const tideLevel = marine?.current.level ?? null;
const tideTrend = marine?.current.trendLabel ?? null;

/** 天氣代碼換算為戶外遊憩適合度（0–100） */
function weatherToScore(code: number): number {
  if (code === 0) return 100;
  if (code === 1) return 92;
  if (code === 2) return 80;
  if (code === 3) return 68;
  if (code === 45 || code === 48) return 55;
  if (code >= 51 && code <= 57) return 48;
  if (code >= 61 && code <= 67) return 34;
  if (code >= 71 && code <= 77) return 22;
  if (code >= 80 && code <= 82) return 30;
  if (code >= 85 && code <= 86) return 22;
  if (code >= 95) return 10;
  return 60;
}

/** 以日落時分的雲量推估夕陽可見度（雲量越低越有機會） */
function sunsetVisibility(bundle: WeatherBundle, sunsetHHMM: string): number {
  const day = bundle.current.time.slice(0, 10);
  const hourStr = sunsetHHMM.slice(0, 2);
  const idx = bundle.hours.findIndex(
    (h) => h.time.slice(0, 10) === day && h.time.slice(11, 13) === hourStr
  );
  const cloud = idx >= 0 ? bundle.hours[idx].cloudCover : bundle.current.cloudCover;
  return Math.max(0, Math.min(100, Math.round(100 - cloud * 0.85)));
}

/** 潮汐與夕陽的搭配程度：滿潮時間越接近日落，海景層次越好 */
function tideScoreFor(nextHighTime: string | undefined, sunsetHHMM: string): number {
  if (!nextHighTime) return 60;
  const toMin = (s: string) => Number(s.slice(0, 2)) * 60 + Number(s.slice(3, 5));
  const diff = Math.abs(toMin(nextHighTime) - toMin(sunsetHHMM));
  if (diff <= 60) return 100;
  if (diff <= 120) return 85;
  if (diff <= 180) return 70;
  return 55;
}

const rainProb = wx ? rainProbNow(wx) : null;

const conditions: Conditions | null = wx
  ? {
      // 風險門檻與天氣建議引擎共用同一組判斷，避免兩處標準不一致
      warning: hasWeatherWarning({
        windMs: wx.current.windSpeed,
        gustMs: wx.current.windGust,
        weatherCode: wx.current.weatherCode,
        todayWeatherCode: wx.days[0]?.weatherCode,
        todayGustMax: wx.days[0]?.gustMax,
      }),
      weatherScore: weatherToScore(wx.current.weatherCode),
      windMs: wx.current.windSpeed,
      rainProb: rainProb ?? 0,
      sunsetVisible: sunsetVisibility(wx, sunset),
      tideScore: tideScoreFor(nextHigh?.time, sunset),
      // 假日人潮較多，略為降低推薦度
      holidayCrowd: isWeekendInTaipei() ? 45 : 85,
    }
  : null;

const status = conditions ? evaluateStatus(conditions) : null;
const s = status ? STATUS_STYLE[status.level] : null;

const rows: { label: string; value: string; hint?: string }[] = [
  { label: '日落時間', value: sunset },
  { label: '降雨機率', value: rainProb === null ? '—' : `${rainProb}%` },
  { label: '平均風速', value: wx ? `每秒 ${Math.round(wx.current.windSpeed)} 公尺` : '—' },
  { label: '陣風', value: wx ? `每秒 ${Math.round(wx.current.windGust)} 公尺` : '—' },
  {
    label: '目前潮位',
    value: tideLevel === null ? '—' : `${tideLevel.toFixed(2)} 公尺`,
    hint: tideTrend ?? undefined,
  },
  {
    label: '下一次滿潮',
    value: nextHigh ? nextHigh.time : '—',
    hint: nextHigh
      ? `${nextHigh.heightM.toFixed(2)} 公尺・${formatCountdown(minutesUntil(nextHigh, now))}`
      : '即時潮汐暫時無法取得',
  },
  {
    label: '下一次乾潮',
    value: nextLow ? nextLow.time : '—',
    hint: nextLow
      ? `${nextLow.heightM.toFixed(2)} 公尺・${formatCountdown(minutesUntil(nextLow, now))}`
      : undefined,
  },
];
---

<section
  aria-labelledby="today-heading"
  class="rounded-2xl border border-scale bg-white p-6 shadow-sm"
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <h2 id="today-heading" class="text-xl">今天適合去魚鱗天梯嗎？</h2>
    <span class="shrink-0 text-xs text-ink/50">依即時天氣與今日潮汐計算</span>
  </div>

  {
    status && s ? (
      <div class:list={['mt-4 flex items-start gap-3 rounded-xl border p-4', s.bg]}>
        <span class:list={['mt-1.5 h-3 w-3 shrink-0 rounded-full', s.dot]} aria-hidden="true" />
        <div>
          <p class:list={['text-lg font-bold', s.text]}>今日旅遊建議：{status.label}</p>
          <p class="mt-1 text-sm text-ink/80">{status.reason}</p>
        </div>
      </div>
    ) : (
      <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
        即時天氣暫時無法取得，因此無法產生整體建議，下方僅顯示可取得的日落與潮汐資訊。出發前請再確認
        <a href="https://www.cwa.gov.tw/" target="_blank" rel="noopener noreferrer" class="underline">中央氣象署</a>最新天氣。
      </div>
    )
  }

  <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-4 sm:grid-cols-3">
    {
      rows.map((r) => (
        <div class="rounded-lg bg-scale/70 px-3 py-3">
          <dt class="text-xs text-ink/60">{r.label}</dt>
          <dd class="mt-0.5 text-lg font-semibold text-deepsea">{r.value}</dd>
          {r.hint && <div class="mt-0.5 text-[11px] text-ink/55">{r.hint}</div>}
        </div>
      ))
    }
  </dl>

  {
    golden && (
      <p class="mt-4 text-sm text-ink/75">
        最佳觀賞窗口約 <strong>
          {golden.start}–{golden.end}
        </strong>（日落 {golden.sunset}）。
      </p>
    )
  }

  {
    !compact && (
      <div class="mt-5 flex flex-wrap gap-2">
        <a
          href="/today/"
          class="rounded-full bg-deepsea px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-ink"
        >
          今日狀況詳情
        </a>
        <a
          href="/tide/"
          class="rounded-full border border-deepsea px-4 py-2 text-sm font-semibold text-deepsea hover:bg-scale"
        >
          查看潮汐
        </a>
        <a
          href="/sunset/"
          class="rounded-full border border-deepsea px-4 py-2 text-sm font-semibold text-deepsea hover:bg-scale"
        >
          日落時間
        </a>
      </div>
    )
  }

  <p class="mt-4 text-xs leading-relaxed text-ink/55">
    天氣與潮汐均為預報資料，實際狀況可能不同。請遵守現場封鎖、警示及工作人員指示。
  </p>
</section>
