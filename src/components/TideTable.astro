---
/**
 * 潮汐表（純呈現元件）
 * 預設使用資料庫中的長期潮汐；由 LiveTide 呼叫時改傳入即時推算的逐日資料。
 */
import { tide } from '../lib/tide';
import { relativeDayLabel, formatMonthDay } from '../lib/format';
import type { TideDay } from '../lib/tide-server';

interface Props {
  days?: number;
  list?: TideDay[];
  showRange?: boolean;
}

const { days = 7, list, showRange = true } = Astro.props;

type Row = {
  date: string;
  events: { type: 'high' | 'low'; time: string; heightM: number }[];
  rangeM?: number;
  spring?: boolean;
};

const rows: Row[] = list && list.length > 0 ? list.slice(0, days) : tide.days.slice(0, days);

const typeLabel = (t: string) => (t === 'high' ? '滿潮' : '乾潮');
---

<div class="overflow-x-auto rounded-xl border border-scale">
  <table class="w-full min-w-[560px] border-collapse text-sm">
    <caption class="sr-only">南寮魚鱗天梯潮汐預報</caption>
    <thead>
      <tr class="bg-deepsea text-left text-white">
        <th class="px-4 py-3 font-semibold">天數</th>
        <th class="px-4 py-3 font-semibold">潮汐時間與水位（公尺，相對平均海平面）</th>
        {showRange && <th class="px-4 py-3 font-semibold">潮差</th>}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((d, i) => (
          <tr class:list={[i % 2 ? 'bg-scale/50' : 'bg-white']}>
            <td class="whitespace-nowrap px-4 py-3 align-top font-medium text-deepsea">
              {relativeDayLabel(i)}
              <span class="block text-xs font-normal text-ink/55">{formatMonthDay(d.date)}</span>
            </td>
            <td class="px-4 py-3">
              {d.events.length === 0 ? (
                <span class="text-ink/50">暫無資料</span>
              ) : (
                <ul class="flex flex-wrap gap-x-5 gap-y-1">
                  {d.events.map((e) => (
                    <li class="whitespace-nowrap">
                      <span
                        class:list={[
                          'inline-block w-9 rounded px-1 text-center text-xs font-semibold',
                          e.type === 'high' ? 'bg-coast/25 text-deepsea' : 'bg-sunset/25 text-ink',
                        ]}
                      >
                        {typeLabel(e.type)}
                      </span>
                      <span class="ml-1 font-medium">{e.time}</span>
                      <span class="ml-1 text-ink/50">{e.heightM.toFixed(2)}m</span>
                    </li>
                  ))}
                </ul>
              )}
            </td>
            {showRange && (
              <td class="whitespace-nowrap px-4 py-3 align-top">
                {d.rangeM !== undefined && d.events.length > 0 ? (
                  <>
                    <span class="font-medium text-deepsea">{d.rangeM.toFixed(2)} m</span>
                    {d.spring !== undefined && (
                      <span
                        class:list={[
                          'ml-1.5 rounded px-1.5 py-0.5 text-xs',
                          d.spring ? 'bg-coast/25 text-deepsea' : 'bg-scale text-ink/60',
                        ]}
                      >
                        {d.spring ? '大潮' : '小潮'}
                      </span>
                    )}
                  </>
                ) : (
                  '—'
                )}
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<p class="mt-3 text-xs text-ink/55">
  資料來源：{list && list.length > 0 ? '海洋數值模式逐時潮位推算' : tide.source}。基準：{tide.datum}。
  潮位為相對平均海平面的高度，潮時受地形與氣象影響可能與現場略有差異；實際潮汐與確切時間請以
  <a href="https://www.cwa.gov.tw/V8/C/T/Marine.html" target="_blank" rel="noopener" class="underline">中央氣象署潮汐預報</a>
  及現場公告為準。
</p>
