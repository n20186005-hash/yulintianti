---
interface Props {
  image: string;
  alt: string;
  h1: string;
  subtitle?: string;
  buttons?: { label: string; href: string; primary?: boolean }[];
  eager?: boolean;
}
const { image, alt, h1, subtitle, buttons = [], eager = false } = Astro.props;
---

<section class="relative overflow-hidden">
  <img
    src={image}
    alt={alt}
    width="1600"
    height="900"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class="absolute inset-0 h-full w-full object-cover"
  />
  <!-- 深色漸層確保文字可讀 -->
  <div class="absolute inset-0 bg-gradient-to-t from-deepsea/90 via-deepsea/55 to-deepsea/25"></div>
  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:py-24">
    <div class="max-w-2xl">
      <h1 class="text-3xl font-bold text-white drop-shadow sm:text-4xl md:text-5xl">{h1}</h1>
      {subtitle && <p class="mt-4 text-base text-scale/95 sm:text-lg">{subtitle}</p>}
      {
        buttons.length > 0 && (
          <div class="mt-7 flex flex-wrap gap-3">
            {buttons.map((b) => (
              <a
                href={b.href}
                class:list={[
                  'rounded-full px-5 py-2.5 text-sm font-semibold transition-colors',
                  b.primary
                    ? 'bg-sunset text-white hover:brightness-95'
                    : 'bg-white/95 text-deepsea hover:bg-white',
                ]}
              >
                {b.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
