---
interface Props {
  sources?: { label: string; href?: string }[];
  editor?: string;
}
const {
  sources = [
    { label: '新竹市政府觀光旅遊網', href: 'https://tourism.hccg.gov.tw/' },
    { label: '中央氣象署開放資料平臺', href: 'https://opendata.cwa.gov.tw/' },
  ],
  editor = '南寮魚鱗天梯編輯部',
} = Astro.props;
---

<section class="mt-10 rounded-xl border border-scale bg-scale/40 p-5 text-sm text-ink/75">
  <h2 class="text-base font-semibold text-deepsea">資料來源與查核</h2>
  <ul class="mt-2 list-disc space-y-1 pl-5">
    {
      sources.map((sc) => (
        <li>
          {sc.href ? (
            <a href={sc.href} target="_blank" rel="noopener" class="underline hover:text-deepsea">{sc.label}</a>
          ) : (
            sc.label
          )}
        </li>
      ))
    }
  </ul>
  <p class="mt-3">編輯：{editor}</p>
  <p class="mt-1 text-xs text-ink/55">
    價格、營業時間與交通班次可能變動，出發前請再次確認官方與現場公告。
  </p>
</section>
