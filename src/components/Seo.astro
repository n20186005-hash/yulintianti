---
import { SITE } from '../data/site.js';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: unknown[];
  appendBrand?: boolean;
}

const {
  title,
  description,
  image = SITE.defaultOgImage,
  imageAlt = '南寮魚鱗天梯（新竹市北區）',
  type = 'website',
  noindex = false,
  jsonLd = [],
  appendBrand = true,
} = Astro.props;

// 每頁唯一 canonical，統一小寫、含尾斜線
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageAbs = new URL(image, SITE.url).href;

// 品牌字尾「｜南寮魚鱗天梯」共 7 字；標題加上後超過 30 字就會被搜尋結果截斷，
// 反而稀釋前面的主要關鍵字，因此過長時不加字尾（品牌仍見於網站名稱與 H1）。
const BRAND_SUFFIX = `｜${SITE.name}`;
const MAX_TITLE_LENGTH = 30;
const fullTitle =
  !appendBrand || title === SITE.siteTitle || title.includes(SITE.name)
    ? title
    : title.length + BRAND_SUFFIX.length <= MAX_TITLE_LENGTH
      ? `${title}${BRAND_SUFFIX}`
      : title;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="theme-color" content={SITE.themeColor} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />

<!-- 結構化資料 -->
{
  jsonLd.map((data) => (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(data)}
    />
  ))
}
