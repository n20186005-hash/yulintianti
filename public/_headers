# Cloudflare Pages 標頭設定

# 靜態資產長快取
/images/*
  Cache-Control: public, max-age=31536000, immutable
/logo.svg
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400

# 避免 Cloudflare Pages 預設 *.pages.dev 測試網域被搜尋引擎收錄
https://:project.pages.dev/*
  X-Robots-Tag: noindex
