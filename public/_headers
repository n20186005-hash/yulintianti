# Cloudflare Workers 靜態資產標頭設定
# 格式：第一行為 URL 或 URL 模式，其後為縮排的「名稱: 值」
# 官方文件：https://developers.cloudflare.com/workers/static-assets/headers/

# 靜態資產長快取
/images/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=31536000, immutable
/logo.svg
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Service Worker：必須即時更新（禁止長快取）
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# 避免 Workers 預設測試網域（<worker>.<subdomain>.workers.dev）被搜尋引擎收錄
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
